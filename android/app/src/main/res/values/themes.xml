<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window stays dark until Compose draws. -->
    <style name="Theme.Pluto" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <!-- The launch: the planet on the canvas, then the app. -->
    <style name="Theme.Pluto.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pluto</item>
    </style>
</resources>
